# ── E-mail capture integracija ─────────────────────────────
# Sajt radi i bez ovih ključeva (lead-ovi se loguju u server konzolu).
# Kada budeš spreman, otkomentariši i popuni jednu od platformi
# pa dopuni src/lib/mailing.ts (jasno označeno gdje).

# MailerLite (preporuka — najjednostavniji)
# MAILERLITE_API_KEY=
# MAILERLITE_GROUP_ID=

# Brevo (Sendinblue)
# BREVO_API_KEY=
# BREVO_LIST_ID=

# Mailchimp
# MAILCHIMP_API_KEY=
# MAILCHIMP_SERVER_PREFIX=us21
# MAILCHIMP_LIST_ID=

# ── Crowdfunding (Faza 2) ──────────────────────────────────
# Kada kampanja krene, popuni link i sajt će automatski
# prikazati "Doniraj sada" dugmad umjesto "Javi mi kada krene".
NEXT_PUBLIC_CAMPAIGN_URL=

# Javni URL sajta (za canonical / OG / hreflang)
NEXT_PUBLIC_SITE_URL=https://www.svrcuge.me
